rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HishApp — Cloud Data Vaults
    // ─────────────────────────────────────────────────────────────
    // A vault is addressed by the doctor's 11-digit mobile number and is
    // unlocked in the app with a 4-digit PIN. The PIN is verified on the
    // CLIENT (see src/services/vaultAuth.ts), so these rules cannot check it —
    // there is no Firebase Auth identity to test against.
    //
    // CONSEQUENCE, stated plainly: anyone who knows (or guesses) an 11-digit
    // number can currently read and write that clinic's ledger. The PIN hash
    // and salt stored on the vault document are readable for the same reason,
    // which is why the hash is stretched with PBKDF2 rather than a single
    // SHA-256 round.
    //
    // Properly closing this needs server-side identity, in this order:
    //   1. Enable Firebase Authentication (phone auth maps 1:1 onto the vault id).
    //   2. Replace `if true` with `request.auth != null && request.auth.uid == phoneNumber`,
    //      or verify the PIN in a Cloud Function that mints a custom claim.
    //   3. Add App Check so only the real PWA can reach the project.
    // Do NOT add those clauses before step 1 exists, or every device will be
    // locked out of its own data.

    match /vaults/{phoneNumber} {
      allow read, write: if true;

      // Only the collections the app actually uses are addressable. This does
      // not authenticate anything, but it stops the vault namespace being used
      // as an arbitrary document dump.
      match /entries/{entryId}         { allow read, write: if true; }
      match /settlements/{settlementId} { allow read, write: if true; }
      match /profiles/{profileId}      { allow read, write: if true; }
      match /audit/{auditId}           { allow read, write: if true; }
      match /snapshots/{snapshotKey}   { allow read, write: if true; }
    }

    // Everything else in the database is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
